  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "storybook": "storybook dev",
    "build:storybook": "storybook build",
    "lint": "eslint ./",
    "lint:fix": "eslint ./ --fix",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "preview:f": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
